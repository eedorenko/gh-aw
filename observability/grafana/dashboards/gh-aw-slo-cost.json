    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens per hour by type",
      "description": "Question: Where do tokens go over time? Input already includes cache, so non-cache input = input - cache read - cache write.\nMetrics: Tier A: emitted by gh-aw.\nSLI: C2.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "clamp_min(sum (rate(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gen_ai_token_type=\"input\"}[$__rate_interval])) - (sum (rate(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gen_ai_token_type=\"cache_read\"}[$__rate_interval])) or vector(0)) - (sum (rate(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gen_ai_token_type=\"cache_write\"}[$__rate_interval])) or vector(0)), 0) * 3600",
          "legendFormat": "input (non-cache)",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "B",
          "expr": "sum (rate(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gen_ai_token_type=\"cache_read\"}[$__rate_interval])) * 3600",
          "legendFormat": "cache read",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "C",
          "expr": "sum (rate(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gen_ai_token_type=\"cache_write\"}[$__rate_interval])) * 3600",
          "legendFormat": "cache write",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "D",
          "expr": "sum (rate(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\", gen_ai_token_type=\"output\"}[$__rate_interval])) * 3600",
          "legendFormat": "output",
          "instant": false,
          "range": true
        }
