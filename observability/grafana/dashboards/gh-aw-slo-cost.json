          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Estimated cost per hour (optional)",
      "description": "Question: How does estimated spend evolve? Tokens x the price variables (USD per 1M tokens, default 0); not an SLO.\nMetrics: Tier A: emitted by gh-aw.\nSLI: C2.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
