          "expr": "((((sum(increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[7d])) + sum(increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"output\"}[7d])))) / ((sum(increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\",gh_aw_safe_output_type!=\"noop\"}[7d]))) > 0)) or (((sum(increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\",gh_aw_safe_output_type!=\"noop\"}[7d]))) > 0) * 0)) / (((((sum(increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[28d])) + sum(increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"output\"}[28d])))) / ((sum(increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\",gh_aw_safe_output_type!=\"noop\"}[28d]))) > 0)) or (((sum(increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\",gh_aw_safe_output_type!=\"noop\"}[28d]))) > 0) * 0)) > 0)",
