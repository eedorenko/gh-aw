{
  "uid": "gh-aw-slo-cost",
  "title": "gh-aw / SLO Cost efficiency",
  "description": "Scan: which workflows violate the Cost efficiency SLOs (\"tokens per useful output and a reasonable burn rate\"), and since when? Click a workflow to drill down.",
  "tags": [
    "gh-aw",
    "otel",
    "slo",
    "scan"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": []
      },
      {
        "name": "workflow",
        "label": "Workflow",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "definition": "label_values(gh_aw_job_duration_seconds_count, gh_aw_workflow_name)",
        "query": {
          "query": "label_values(gh_aw_job_duration_seconds_count, gh_aw_workflow_name)",
          "refId": "var_workflow",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0
      },
      {
        "name": "slo_window",
