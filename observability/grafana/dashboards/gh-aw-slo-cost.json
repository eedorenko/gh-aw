    {
      "id": 5,
      "type": "timeseries",
      "title": "C4 Credit and rate-limit events vs SLO",
      "description": "Question: When did credit and rate-limit events cross its SLO? Rolling $slo_window value; honours the Workflow variable.\nMetrics: Tier A: emitted by gh-aw.\nSLI: C4.\nSLO: ≤ 0.",
      "datasource": {
