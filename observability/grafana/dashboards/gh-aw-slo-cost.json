  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Cost efficiency SLIs per workflow (worst first, click a workflow to drill down)",
      "description": "Question: Which workflows violate the Cost efficiency SLOs? Cells are coloured against the SLO; \"Jobs in window\" shows the sample size.\nMetrics: Tier A: emitted by gh-aw.\nSLI: C1, C2, C3.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "((((sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[7d])) + sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"output\"}[7d])))) / ((sum by (gh_aw_workflow_name) (increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\",gh_aw_safe_output_type!=\"noop\"}[7d]))) > 0)) or (((sum by (gh_aw_workflow_name) (increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\",gh_aw_safe_output_type!=\"noop\"}[7d]))) > 0) * 0)) / (((((sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[28d])) + sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"output\"}[28d])))) / ((sum by (gh_aw_workflow_name) (increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\",gh_aw_safe_output_type!=\"noop\"}[28d]))) > 0)) or (((sum by (gh_aw_workflow_name) (increase(gh_aw_workflow_output_items_total{gh_aw_workflow_name=~\"$workflow\",gh_aw_safe_output_type!=\"noop\"}[28d]))) > 0) * 0)) > 0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "B",
          "expr": "(((sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[1d])) + sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"output\"}[1d])))) / (((sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[7d])) + sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"output\"}[7d]))) / 7) > 0)) or ((((sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[7d])) + sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"output\"}[7d]))) / 7) > 0) * 0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "C",
          "expr": "((sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"cache_read\"}[$slo_window]))) / ((sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[$slo_window]))) > 0)) or (((sum by (gh_aw_workflow_name) (increase(gen_ai_client_token_usage_total{gh_aw_workflow_name=~\"$workflow\",gen_ai_token_type=\"input\"}[$slo_window]))) > 0) * 0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "D",
          "expr": "sum by (gh_aw_workflow_name) (increase(gh_aw_job_duration_seconds_count{gh_aw_workflow_name=~\"$workflow\",cicd_pipeline_task_run_result!=\"cancelled\"}[$slo_window]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
